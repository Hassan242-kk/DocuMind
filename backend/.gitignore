cat << 'EOF' > .gitignore
# Environment & Secrets
.env
.env.*
!.env.example
*.env

# Operating System
.DS_Store
*/.DS_Store

# Python & Virtual Environment
venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Node & Next.js
node_modules/
*/node_modules/
.next/
out/
build/
dist/

# Uploaded Files
uploads/
backend/uploads/
EOF